<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VoiceRecognitionMaui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Label
                x:Name="lblRecognition"
                FontSize="32"
                HorizontalOptions="Center"
                Text="Voice Recognition in .NET MAUI" />
            <Button x:Name="btnRecord" Text="Start Recording" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
